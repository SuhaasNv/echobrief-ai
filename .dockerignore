# Keep the mobile app out of the API and web images entirely.
# Both Dockerfiles use explicit COPY steps, but this makes the intent enforced
# rather than incidental, and keeps the build context small.
apps/

node_modules
**/node_modules

# Build output
dist
.vite
.output
.tanstack

# iOS / Expo build artifacts (in case apps/ is ever copied deliberately)
ios
android
.expo

# Local env + secrets — must never enter an image layer
.env
.env.*
.dev.vars

# VCS + editor
.git
.github
.vscode
.idea
.DS_Store

# Docs, tests, and tooling that production images don't need
docs
tests
coverage
*.md
!README.md
