{
  "expo": {
    "name": "EchoBrief",
    "slug": "echobrief",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "echobrief",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.suhaasnv.echobrief"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06070A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "EchoBrief uses the microphone to record the meetings you choose to capture. Recording starts only when you press Record and stops when you press Stop."
        }
      ]
    ]
  }
}
