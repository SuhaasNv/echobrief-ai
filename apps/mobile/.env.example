# Copy to .env.local (gitignored) and set for your machine.
#
# EXPO_PUBLIC_* values are INLINED into the bundle by Metro at build time, not
# read at runtime. Changing this requires a reload, and for a release build a
# full rebuild. They are also plaintext in the shipped binary — never put a
# secret here.
#
# The variable must be referenced as a static process.env.X member expression to
# be inlined. process.env["..."] and destructuring are NOT inlined and silently
# yield undefined.

# --- Option A: deployed API (simplest; HTTPS, so no ATS or Local Network prompt)
# Note this points a dev build at PRODUCTION data.
# EXPO_PUBLIC_API_URL=https://api-production-5cfb.up.railway.app

# --- Option B: API on this Mac, from the iPhone over Wi-Fi (recommended for dev)
# Find the LAN IP with:  ipconfig getifaddr en0
# src/api.ts already binds 0.0.0.0, so no server change is needed.
#
# Phone -> Mac traffic is layer-2 on the same subnet, so a router rule allowing
# only ports 80/443/22 outbound does not block it. If it fails, the cause is
# AP/client isolation, a VLAN split, the macOS firewall, or iOS Local Network
# Privacy — not that rule. Diagnostic: open the URL in mobile Safari, which is
# exempt from Local Network Privacy. If Safari works and the app does not, it is
# a permissions issue, not the network.
#
# Expo's prebuild Info.plist already sets NSAllowsLocalNetworking=true, so a
# plain http:// LAN address works on iOS 17+ with no extra config.
EXPO_PUBLIC_API_URL=http://192.168.1.42:4000

# --- Option C: tunnel (café, cellular, or an AP that isolates clients)
# ngrok works on a 80/443/22-only network (agent connects over 443).
# cloudflared does NOT — it needs port 7844, and --protocol http2 does not fall
# back to 443, it just swaps UDP:7844 for TCP:7844.
#   ngrok http 4000
# EXPO_PUBLIC_API_URL=https://<subdomain>.ngrok-free.app
